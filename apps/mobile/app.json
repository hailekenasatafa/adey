{
  "expo": {
    "name": "Adey Connect",
    "slug": "adey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "adey",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Adey Connect (አደይ) — Connecting Communities. Growing Businesses. Discover Habesha businesses, shop verified Ethiopian sellers, and grow with AdConnect.",
    "primaryColor": "#174B3A",
    "backgroundColor": "#FAF8F2",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#174B3A",
      "dark": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#15181A" }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adeyconnect.app",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Adey Connect uses your location to show Habesha businesses and advertising screens near you.",
        "NSCameraUsageDescription": "Adey Connect uses the camera so you can add photos of your business, products, or screens.",
        "NSPhotoLibraryUsageDescription": "Adey Connect needs photo access to upload business photos, product images, and campaign creatives.",
        "NSPhotoLibraryAddUsageDescription": "Adey Connect can save images you download to your photo library.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "associatedDomains": ["applinks:adeyconnect.com"]
    },
    "android": {
      "package": "com.adeyconnect.app",
      "adaptiveIcon": {
        "backgroundColor": "#174B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "adeyconnect.com", "pathPrefix": "/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "config": {
        "googleMaps": { "apiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_API_KEY" }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "resizeMode": "contain", "backgroundColor": "#174B3A", "dark": { "backgroundColor": "#15181A" } }],
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#174B3A", "defaultChannel": "default" }],
      ["expo-location", { "locationWhenInUsePermission": "Adey Connect uses your location to show Habesha businesses and advertising screens near you." }],
      ["expo-image-picker", { "photosPermission": "Adey Connect needs photo access to upload business photos, product images, and campaign creatives.", "cameraPermission": "Adey Connect uses the camera so you can add photos of your business, products, or screens." }],
      ["expo-video", { "supportsBackgroundPlayback": false, "supportsPictureInPicture": false }],
      ["react-native-maps", { "iosGoogleMapsApiKey": "" }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" },
      "router": { "root": "./src/app" }
    },
    "owner": "REPLACE_WITH_EXPO_ACCOUNT",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "https://u.expo.dev/REPLACE_WITH_EAS_PROJECT_ID" }
  }
}
