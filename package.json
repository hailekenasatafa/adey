{
  "name": "adey",
  "private": true,
  "version": "0.1.0",
  "description": "ADEY (አደይ) — Connecting Communities. Growing Businesses. Monorepo: shared backend contracts, mobile app (Expo), website (Next.js).",
  "scripts": {
    "mobile": "pnpm --filter @adey/mobile start",
    "web": "pnpm --filter @adey/web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > packages/shared/src/database.types.ts",
    "db:test": "node supabase/tests/run_local.mjs",
    "db:types:local": "node supabase/tests/run_local.mjs --no-tests --types",
    "check:functions": "node supabase/tests/check_edge_calls.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16"
  }
}
